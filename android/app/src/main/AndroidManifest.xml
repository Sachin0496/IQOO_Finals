<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.camera.front" android:required="true" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Voice mode only (weak or unclear speech): asked for when the person switches to Voice. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Network use: Sarvam text-to-speech on calls (the words go out, a WAV comes back), and web calls, where Mouna's
         spoken voice goes to the other person and theirs comes back, through the call relay (call-server/).
         Nothing from the camera or the microphone leaves the phone. Network state stays removed (spike test S6),
         whatever a library merges in. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <!-- Phone calls: dial (CALL_PHONE), hang up (ANSWER_PHONE_CALLS), bring Mouna back to the front after dialing. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.REORDER_TASKS" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <!-- Names the person says ("call Nakul") are looked up in the phone's own contacts, read on the phone only. Asked for
         the first time a name is not found; without it, only Mouna's own favourites are known. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Lets the app ask the system TTS engine which voices exist (fallback voice). -->
    <!-- Phone actions open other apps (the dialler, WhatsApp, messages) and check WhatsApp is there. No SMS send.
         "Open an app" lists the launcher's apps, so it can start them by name. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="com.whatsapp" />
    </queries>

    <application
        android:allowBackup="false"
        android:label="Mouna"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Probe">

        <!-- QNN HTP backend: the vendor DSP libraries are loaded by name from the system. -->
        <uses-native-library android:name="libcdsprpc.so" android:required="false" />

        <activity
            android:name="app.mouna.app.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="uiMode|fontScale|density|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation|locale|layoutDirection|mcc|mnc">
            <!-- The activity is not recreated by these changes (dark mode, font size, display size, a keyboard, the system
                 language, a SIM or network change): a recreate mid-call would drop the call. Compose and CameraX follow the
                 new configuration on their own. The screen is kept on in code (MainActivity.onCreate): keepScreenOn is a
                 View attribute and does nothing on an <activity>. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- QA tools: the spike probe (S1 crop/fps, S5 voices, S6 permissions + soak), opened from Settings. -->
        <activity
            android:name="app.mouna.probe.ProbeActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:keepScreenOn="true" />
    </application>
</manifest>
